<div class="space-y-4 text-center py-16">
  <h1 class="text-5xl font-bold bg-gradient-to-r from-blue-400 to-indigo-500 bg-clip-text text-transparent">
    Welcome to Nuvsha
  </h1>
  <p class="text-xl text-slate-300">
    Your new Nuvsha application is running.
  </p>
  
  <div class="mt-8">
    <script>
      let count = 0
    </script>
    <button 
      class="px-6 py-3 bg-blue-600 hover:bg-blue-500 rounded-lg text-white font-medium transition-colors shadow-lg"
      onclick="count++"
    >
      Count is: {count}
    </button>
  </div>
</div>
