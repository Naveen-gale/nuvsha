<script>
  name = "Nuvsha"
  age = 1
  items = ["HTML", "CSS", "JavaScript"]
</script>

<div class="app">
  <header>
    <h1>Hello {name}!</h1>
    <p>Version {age}</p>
  </header>

  <main>
    <ul>
      {for item of items}
        <li>{item}</li>
      {/for}
    </ul>

    <button onclick="age++">
      Increase
    </button>
  </main>
</div>