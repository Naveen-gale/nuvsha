<div class="space-y-4">
  <h1 class="text-4xl font-bold">Nuvsha</h1>
  <p class="text-xl text-slate-300">Build UI with less code.</p>
  <p class="text-slate-400">This is the Nuvsha routing playground.</p>
  
  <div class="mt-8 p-6 bg-slate-900 rounded-lg border border-slate-800">
    <h2 class="text-2xl font-semibold mb-4">Reactivity Demo</h2>
    <script>
      let count = 0
    </script>
    <p class="mb-4 text-slate-300">Count is: {count}</p>
    <button 
      class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded text-white font-medium transition-colors"
      onclick="count++"
    >
      Increment
    </button>
  </div>
</div>
