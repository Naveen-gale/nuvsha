<div class="space-y-4">
  <h1 class="text-4xl font-bold">Contact</h1>
  <p class="text-slate-300">
    Get in touch with the Nuvsha team.
  </p>
  
  <form class="mt-8 space-y-4 max-w-md">
    <div>
      <label class="block text-sm font-medium text-slate-400 mb-1">Name</label>
      <input type="text" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-white focus:outline-none focus:border-blue-500" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-400 mb-1">Message</label>
      <textarea class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-white focus:outline-none focus:border-blue-500 h-32"></textarea>
    </div>
    <button type="button" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded text-white font-medium transition-colors">
      Send Message
    </button>
  </form>
</div>
