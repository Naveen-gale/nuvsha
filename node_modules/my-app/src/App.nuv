<script>
  name = ""
  count = 0
  show = true
  items = ["HTML", "CSS"]

  addItem = () => {
    items.push("JavaScript")
  }
</script>

<div class="app">

  <h1>Nuvsha Demo</h1>

  <section>
    <h2>Form Binding (Phase 3)</h2>
    <input bind={name} placeholder="Type your name">
    <p>Hello <strong>{name || "stranger"}</strong></p>
  </section>

  <section>
    <h2>Counter (Phase 1 + 2)</h2>
    <p class="count">{count}</p>
    <button onclick="count++">+ Add</button>
    <button onclick="count--">- Remove</button>
    <p>Next: {count + 1}</p>
  </section>

  <section>
    <h2>Conditional (Phase 6)</h2>
    <button onclick="show = !show">Toggle Message</button>
    {if show}
      <p class="visible">The message is visible!</p>
    {else}
      <p class="hidden">Message is hidden.</p>
    {/if}
  </section>

  <section>
    <h2>Reactive List (Phase 4)</h2>
    <ul>
      {for item of items}
        <li>{item}</li>
      {/for}
    </ul>
    <button onclick="addItem()">Add JavaScript</button>
  </section>

</div>
