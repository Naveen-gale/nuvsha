<script>
  newsletter = form({ email: "" })
  
  subscribe = async (values) => {
    if (!values.email) throw new Error("Email is required");
    await new Promise(r => setTimeout(r, 1000));
    return "Subscribed!";
  }
</script>

<div class="space-y-4">
  <h1 class="text-4xl font-bold">Nuvsha</h1>
  <p class="text-xl text-slate-300">Build UI with less code.</p>
  <p class="text-slate-400">This is the Nuvsha routing playground.</p>
  
  <div class="mt-8 p-6 bg-slate-900 rounded-lg border border-slate-800">
    <h2 class="text-2xl font-semibold mb-4">Phase 18 Forms Demo</h2>
    <p class="mb-4 text-slate-300">Test the new form primitive instantly:</p>
    
    {if newsletter.success}
      <div class="text-green-400 font-bold p-4 bg-green-500/10 rounded-lg">
        Successfully subscribed!
        <button class="ml-4 text-sm underline text-green-300" onclick="newsletter.reset()">Reset</button>
      </div>
    {else}
      <form onsubmit="newsletter.submit(subscribe)" class="flex gap-4 items-start">
        <div class="flex-1">
          <input 
            type="email" 
            bind={newsletter.email} 
            disabled={newsletter.loading}
            placeholder="Enter your email" 
            class="w-full px-4 py-2 bg-slate-800 border border-slate-700 rounded text-white disabled:opacity-50"
          >
          {if newsletter.error}
            <p class="text-red-400 text-sm mt-2">{newsletter.error}</p>
          {/if}
        </div>
        <button 
          type="submit" 
          disabled={newsletter.loading}
          class="px-6 py-2 bg-sky-600 hover:bg-sky-500 rounded text-white font-medium disabled:opacity-50 transition-colors"
        >
          {if newsletter.loading} Wait... {else} Subscribe {/if}
        </button>
      </form>
    {/if}
  </div>
</div>
