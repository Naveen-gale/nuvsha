<script>
  import { Router } from "nuvsha";
  import { routes } from "./router/routes.js";
  import Navbar from "./components/Navbar.nuv";
  import Card from "./components/Card.nuv";
  import Button from "./components/Button.nuv";
  import Counter from "./components/Counter.nuv";

  count = 0
  name = "Alex"
</script>

<div class="min-h-screen bg-slate-950 text-white font-sans">
  <Navbar />
  <main class="max-w-4xl mx-auto p-8">
    
    <div class="mb-12">
      <h1 class="text-4xl font-black text-white mb-2 tracking-tight">Nuvsha Phase 16</h1>
      <p class="text-sky-400 font-medium">Component System Demonstration</p>
    </div>

    <Card title="Component Composition">
      <p class="text-gray-600 mb-6 text-lg">
        Hello <span class="font-bold text-sky-600">{name}</span>! This card demonstrates 
        <code class="bg-gray-100 text-pink-600 px-1 py-0.5 rounded">props</code>, 
        <code class="bg-gray-100 text-pink-600 px-1 py-0.5 rounded">children</code>, and 
        <code class="bg-gray-100 text-pink-600 px-1 py-0.5 rounded">events</code>.
      </p>

      <div class="mb-6 flex items-center space-x-4 border-b border-gray-100 pb-6">
        <Button onclick={() => count++}>
          Parent Count: {count}
        </Button>
        <Button disabled>
          Disabled Button
        </Button>
      </div>

      <h4 class="font-bold text-gray-800 mb-2 uppercase text-sm tracking-wider">Component Isolation Test</h4>
      <p class="text-sm text-gray-500 mb-4">Clicking one counter should not affect the others, proving isolated reactive state.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <Counter value={count} onchange="count = $event" />
        <Counter value={99} onchange="console.log('Isolated counter changed: ' + $event)" />
      </div>
    </Card>

    <Card>
      <p class="text-gray-600">This card uses the default title prop.</p>
    </Card>

    <div class="mt-12 pt-8 border-t border-slate-800">
      <h2 class="text-2xl font-bold text-white mb-6">Existing Router Test</h2>
      <Router routes={routes} />
    </div>

  </main>
</div>