{
  "name": "nuvsha-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "nuvsha",
    "playground",
    "nuvsha-master-test",
    "create-nuvsha",
    "tailwind-test",
    "nadashboard"
  ],
  "scripts": {
    "test": "node --test nuvsha/tests/*.test.js create-nuvsha/tests/*.test.js tests/*.test.js",
    "test:nuvsha": "node --test nuvsha/tests/*.test.js",
    "test:cli": "node --test create-nuvsha/tests/*.test.js",
    "master-test:dev": "npm --prefix nuvsha-master-test run dev",
    "master-test:build": "npm --prefix nuvsha-master-test run build",
    "master-test:preview": "npm --prefix nuvsha-master-test run preview",
    "nadashboard:dev": "npm --prefix nadashboard run dev",
    "nadashboard:build": "npm --prefix nadashboard run build",
    "nadashboard:preview": "npm --prefix nadashboard run preview"
  }
}
