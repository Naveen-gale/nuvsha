<script>
  import TestSection from "../components/TestSection.nuv";
  import Badge from "../components/Badge.nuv";

  errorCatalog = [
    { code: "NV1001", name: "Unexpected End of Input", phase: "LEXER", hint: "Ensure closing tags are properly terminated with '>'" },
    { code: "NV1002", name: "Unexpected Closing Tag", phase: "PARSER", hint: "Check for mismatched or orphan </tag> closers" },
    { code: "NV1003", name: "Missing Closing Tag", phase: "PARSER", hint: "Check that open elements and blocks like {if} have closers" },
    { code: "NV1004", name: "Unclosed Expression Block", phase: "LEXER", hint: "Ensure opening { braces have matching } braces" },
    { code: "NV1007", name: "Unexpected Else/Else-If", phase: "PARSER", hint: "Ensure {else} is placed inside an open {if} block" },
    { code: "NV1008", name: "Invalid For-Loop Syntax", phase: "PARSER", hint: "Use standard '{for item of items}' expression format" },
    { code: "NV1009", name: "Invalid Attribute Syntax", phase: "LEXER", hint: "Ensure attributes have valid names and closed quotes" }
  ]
</script>

<div class="space-y-6">
  <div>
    <h1 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">
      Phase 13 — Compiler Errors & DX Diagnostics
    </h1>
    <p class="text-sm text-slate-400 mt-1">
      Validating beginner-friendly compiler diagnostics, source code frames, error code taxonomy, and IDE helpful hints.
    </p>
  </div>

  <TestSection 
    phase="Phase 13" 
    title="Nuvsha Compiler Diagnostic Error Codes" 
    description="All 7 compiler error codes verified in automated unit test suite without breaking runtime app."
    status="PASS">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-300">
        <thead class="text-xs uppercase bg-slate-950/60 text-slate-400 border-b border-slate-800 font-mono">
          <tr>
            <th class="px-4 py-3">Code</th>
            <th class="px-4 py-3">Error Title</th>
            <th class="px-4 py-3">Phase</th>
            <th class="px-4 py-3">Helpful Hint / Diagnostic</th>
            <th class="px-4 py-3 text-right">Unit Test</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 font-mono text-xs">
          {for err of errorCatalog}
            <tr class="hover:bg-slate-800/40">
              <td class="px-4 py-3 font-bold text-rose-400">{err.code}</td>
              <td class="px-4 py-3 font-medium text-white">{err.name}</td>
              <td class="px-4 py-3 text-sky-400">{err.phase}</td>
              <td class="px-4 py-3 text-slate-400">{err.hint}</td>
              <td class="px-4 py-3 text-right">
                <Badge text="VERIFIED" variant="success" />
              </td>
            </tr>
          {/for}
        </tbody>
      </table>
    </div>
  </TestSection>

  <div class="p-6 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-300 space-y-2">
    <p class="text-slate-500 font-bold">// Example Code Frame Emitted in Terminal on Error:</p>
    <p class="text-rose-400 font-bold">Nuvsha Error [NV1004]: Unclosed expression block</p>
    <p class="text-slate-400">File: src/pages/Example.nuv</p>
    <p class="text-slate-400">Line: 12, Column: 8</p>
    <div class="p-3 bg-slate-900 rounded border border-slate-800 text-slate-300 mt-2 space-y-1">
      <p>  10 | &lt;div class="card"&gt;</p>
      <p>  11 |   &lt;h1&gt;Welcome&lt;/h1&gt;</p>
      <p class="text-rose-400 font-bold">&gt; 12 |   &lt;p&gt;Count is &amp;#123;count&lt;/p&gt;</p>
      <p class="text-rose-400">     |               ^^^^^</p>
      <p>  13 | &lt;/div&gt;</p>
    </div>
    <p class="text-sky-400 mt-2">Hint: Ensure all opening &#123; braces have a matching closing &#125; brace.</p>
  </div>
</div>
