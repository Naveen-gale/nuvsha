<script>
  import TestSection from "../components/TestSection.nuv";
  import Button from "../components/Button.nuv";
  import Card from "../components/Card.nuv";
  import { navigate } from "nuvsha";

  currentLocation = window.location.pathname

  goTo = (path) => {
    navigate(path)
  }
</script>

<div class="space-y-6">
  <div>
    <h1 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">
      Phase 10 — Client-Side SPA Routing
    </h1>
    <p class="text-sm text-slate-400 mt-1">
      Validating client-side page rendering without full page reloads, history API manipulation, link interception, and wildcard fallback.
    </p>
  </div>

  <TestSection 
    phase="Phase 10" 
    title="SPA Router & History API Testing" 
    description="Tests link interception, programmatic navigate(path), and popstate events."
    status="PASS">
    <div class="space-y-6">
      <div class="p-4 rounded-lg bg-slate-950 border border-slate-800 font-mono text-sm">
        <p class="text-slate-400">// Current Route Status</p>
        <p class="text-sky-300">window.location.pathname: <span class="text-white font-bold">{currentLocation}</span></p>
      </div>

      <div>
        <h4 class="text-sm font-bold text-white mb-3">Programmatic Navigation (navigate)</h4>
        <div class="flex flex-wrap gap-2">
          <Button variant="secondary" onclick={() => goTo("/")}>
            Go to / (Overview)
          </Button>
          <Button variant="secondary" onclick={() => goTo("/language")}>
            Go to /language
          </Button>
          <Button variant="secondary" onclick={() => goTo("/data")}>
            Go to /data
          </Button>
          <Button variant="danger" onclick={() => goTo("/non-existent-route-demo")}>
            Test 404 Wildcard Fallback
          </Button>
        </div>
      </div>

      <div>
        <h4 class="text-sm font-bold text-white mb-3">Standard HTML Anchor Interception</h4>
        <p class="text-xs text-slate-400 mb-3">These are standard &lt;a href="..."&gt; tags intercepted seamlessly by Nuvsha router without page reloads:</p>
        <div class="flex flex-wrap gap-3">
          <a href="/components" class="px-3 py-1.5 rounded bg-slate-900 hover:bg-slate-800 border border-slate-800 text-xs font-semibold text-sky-400 hover:text-sky-300 transition">
            /components
          </a>
          <a href="/styling" class="px-3 py-1.5 rounded bg-slate-900 hover:bg-slate-800 border border-slate-800 text-xs font-semibold text-sky-400 hover:text-sky-300 transition">
            /styling
          </a>
          <a href="/async" class="px-3 py-1.5 rounded bg-slate-900 hover:bg-slate-800 border border-slate-800 text-xs font-semibold text-sky-400 hover:text-sky-300 transition">
            /async
          </a>
        </div>
      </div>
    </div>
  </TestSection>
</div>
