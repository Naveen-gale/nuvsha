<script>
  import TestSection from "../components/TestSection.nuv";
  import Button from "../components/Button.nuv";
  import StatCard from "../components/StatCard.nuv";

  perfCounter = 0
  benchIterations = 0
  benchTotalMs = 0
  benchAvgMs = 0
  isRunning = false

  runFastBenchmark = (count) => {
    isRunning = true
    const start = performance.now()
    for (let i = 0; i < count; i++) {
      perfCounter++
    }
    const end = performance.now()
    const total = end - start
    benchIterations = count
    benchTotalMs = Number(total.toFixed(2))
    benchAvgMs = Number((total / count).toFixed(4))
    isRunning = false
  }

  resetBenchmark = () => {
    perfCounter = 0
    benchIterations = 0
    benchTotalMs = 0
    benchAvgMs = 0
  }
</script>

<div class="space-y-6">
  <div>
    <h1 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">
      Phase 14 — Performance & Production Bundling
    </h1>
    <p class="text-sm text-slate-400 mt-1">
      Benchmarking fine-grained reactive state updates without Virtual DOM diffing overhead or unnecessary component re-renders.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <StatCard title="Benchmark Counter" value={perfCounter} subtitle="Active reactive state" trend="Real-time" icon="⚡" />
    <StatCard title="Total Duration" value={benchTotalMs + " ms"} subtitle="For last benchmark run" trend="Low latency" icon="⏱️" />
    <StatCard title="Avg Update Time" value={benchAvgMs + " ms"} subtitle="Per reactive update" trend="Sub-millisecond" icon="🚀" />
  </div>

  <TestSection 
    phase="Phase 14" 
    title="High-Frequency Reactive State Benchmark" 
    description="Executes rapid synchronous state updates to measure $watch and DOM dirty-checking speed."
    status="PASS">
    <div class="space-y-4">
      <div class="flex flex-wrap gap-3">
        <Button onclick={() => runFastBenchmark(500)}>
          Run 500 Updates
        </Button>
        <Button onclick={() => runFastBenchmark(2000)}>
          Run 2,000 Updates
        </Button>
        <Button onclick={() => runFastBenchmark(5000)}>
          Run 5,000 Updates
        </Button>
        <Button variant="secondary" onclick={() => resetBenchmark()}>
          Reset Metrics
        </Button>
      </div>

      <div class="p-4 rounded-lg bg-slate-950 border border-slate-800 font-mono text-sm space-y-2">
        <p class="text-slate-400">// Benchmark Output Telemetry</p>
        <p class="text-slate-300">Completed Iterations: <span class="text-sky-400 font-bold">{benchIterations}</span></p>
        <p class="text-slate-300">Total Execution Time: <span class="text-emerald-400 font-bold">{benchTotalMs} ms</span></p>
        <p class="text-slate-300">Average Latency Per Update: <span class="text-indigo-400 font-bold">{benchAvgMs} ms</span></p>
      </div>
    </div>
  </TestSection>
</div>
