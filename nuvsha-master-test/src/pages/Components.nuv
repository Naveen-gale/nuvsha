<script>
  import TestSection from "../components/TestSection.nuv";
  import Card from "../components/Card.nuv";
  import StatCard from "../components/StatCard.nuv";
  import Button from "../components/Button.nuv";
  import Badge from "../components/Badge.nuv";

  parentCount = 5
  parentTitle = "Dynamic Parent Prop"
  childEventLog = "Waiting for child event..."

  handleCustomEvent = (val) => {
    childEventLog = "Received event from child: " + val
  }
</script>

<div class="space-y-6">
  <div>
    <h1 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">
      Phase 5 & 16 — Component System
    </h1>
    <p class="text-sm text-slate-400 mt-1">
      Verifying props passing, parent-child reactive synchronization, slot projection ({children}), and component-level events.
    </p>
  </div>

  <!-- Test 1: Props Passing & Parent->Child Sync -->
  <TestSection 
    phase="Phase 5" 
    title="Reactive Props Passing (Parent → Child)" 
    description="Dynamic props passed to child components update automatically when parent state changes."
    status="PASS">
    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-3">
        <Button onclick={() => parentCount++}>
          Increment Parent Count ({parentCount})
        </Button>
        <Button variant="secondary" onclick={() => parentCount = 0}>
          Reset Parent Count
        </Button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <StatCard title="Parent State Sync" value={parentCount} subtitle="Dynamic prop value" trend="Synced" icon="🔄" />
        <StatCard title="Computed Prop x2" value={parentCount * 2} subtitle="Expression prop passed" trend="Calculated" icon="⚡" />
        <StatCard title="Static Prop Component" value="Static 100" subtitle="Hardcoded string prop" trend="Constant" icon="📌" />
      </div>
    </div>
  </TestSection>

  <!-- Test 2: Children Slot Projection ({children}) -->
  <TestSection 
    phase="Phase 16" 
    title="Slot Projection ({children} Keyword)" 
    description="Passes nested DOM markup from parent into child component's {children} slot fragment."
    status="PASS">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <Card title="Slot Projection Card A" subtitle="Custom nested markup in slot">
        <div class="p-3 rounded-lg bg-sky-950/30 border border-sky-500/20 text-sm text-sky-200">
          <p class="font-semibold text-white mb-1">🎉 Slot Injection Successful</p>
          <p class="text-xs text-sky-300">This paragraph was rendered inside the parent and projected into Card's {children} placeholder.</p>
        </div>
      </Card>

      <Card title="Slot Projection Card B" subtitle="Interactive elements inside slot">
        <div class="space-y-3">
          <p class="text-xs text-slate-400">Parent count inside projected slot: <strong class="text-white">{parentCount}</strong></p>
          <div class="flex gap-2">
            <Badge text="SLOT ACTIVE" variant="success" />
            <Badge text="NO VDOM" variant="info" />
          </div>
        </div>
      </Card>
    </div>
  </TestSection>

  <!-- Test 3: Default Props Fallback -->
  <TestSection 
    phase="Phase 16" 
    title="Default Props Fallback & Component Isolation" 
    description="When a prop is not provided, the component falls back to its default value defined in <script>."
    status="PASS">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <Card>
        <p class="text-sm text-slate-300">This card was instantiated as <code class="text-pink-400">&lt;Card&gt;</code> without a title prop, so it safely defaulted without errors.</p>
      </Card>
      <Card title="Explicit Title Prop Provided">
        <p class="text-sm text-slate-300">This card was instantiated as <code class="text-pink-400">&lt;Card title="..."&gt;</code> with an explicit title prop.</p>
      </Card>
    </div>
  </TestSection>
</div>
