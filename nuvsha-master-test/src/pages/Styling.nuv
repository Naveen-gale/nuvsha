<script>
  import TestSection from "../components/TestSection.nuv";
  import Card from "../components/Card.nuv";
  import Button from "../components/Button.nuv";

  activeTab = "layout"

  setTab = (tab) => {
    activeTab = tab
  }
</script>

<div class="space-y-6">
  <div>
    <h1 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">
      Phase 9 — Tailwind CSS Integration
    </h1>
    <p class="text-sm text-slate-400 mt-1">
      Verifying full compatibility with Tailwind CSS v4 inside .nuv single-file components, including responsive grids, gradients, and micro-interactions.
    </p>
