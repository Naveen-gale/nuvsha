  <div class="flex gap-2 border-b border-slate-800 pb-3">
    <Button 
      variant={activeTab === 'layout' ? 'primary' : 'secondary'} 
      onclick={() => setTab("layout")}>
      Layout & Grids
    </Button>
    <Button 
      variant={activeTab === 'gradients' ? 'primary' : 'secondary'} 
      onclick={() => setTab("gradients")}>
      Gradients & Cards
    </Button>
    <Button 
      variant={activeTab === 'typography' ? 'primary' : 'secondary'} 
      onclick={() => setTab("typography")}>
      Typography & Spacing
    </Button>
  </div>

  {if activeTab === 'layout'}
    <TestSection 
      phase="Phase 9" 
      title="Responsive Grid & Flexbox Utilities" 
      description="Tailwind CSS v4 scanning .nuv files directly for classes."
      status="PASS">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-5 rounded-xl bg-slate-900 border border-slate-800 hover:border-sky-500/40 transition">
          <span class="text-xs font-mono text-sky-400">col-1</span>
          <p class="text-white font-bold mt-1">Responsive Card 1</p>
          <p class="text-xs text-slate-400 mt-2">Scales smoothly from mobile to 4K displays.</p>
        </div>
        <div class="p-5 rounded-xl bg-slate-900 border border-slate-800 hover:border-sky-500/40 transition">
          <span class="text-xs font-mono text-sky-400">col-2</span>
          <p class="text-white font-bold mt-1">Responsive Card 2</p>
          <p class="text-xs text-slate-400 mt-2">Scales smoothly from mobile to 4K displays.</p>
        </div>
        <div class="p-5 rounded-xl bg-slate-900 border border-slate-800 hover:border-sky-500/40 transition">
          <span class="text-xs font-mono text-sky-400">col-3</span>
          <p class="text-white font-bold mt-1">Responsive Card 3</p>
          <p class="text-xs text-slate-400 mt-2">Scales smoothly from mobile to 4K displays.</p>
        </div>
        <div class="p-5 rounded-xl bg-slate-900 border border-slate-800 hover:border-sky-500/40 transition">
          <span class="text-xs font-mono text-sky-400">col-4</span>
          <p class="text-white font-bold mt-1">Responsive Card 4</p>
          <p class="text-xs text-slate-400 mt-2">Scales smoothly from mobile to 4K displays.</p>
        </div>
      </div>
    </TestSection>
  {else if activeTab === 'gradients'}
    <TestSection 
      phase="Phase 9" 
      title="Gradients, Glassmorphism & Shadows" 
      description="Advanced modern styling tokens in Nuvsha components."
      status="PASS">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-6 rounded-2xl bg-gradient-to-br from-sky-600 to-blue-800 text-white shadow-xl shadow-sky-900/30">
          <h4 class="text-lg font-black">Ocean Blue Gradient</h4>
          <p class="text-xs text-sky-100 mt-2">from-sky-600 to-blue-800</p>
        </div>
        <div class="p-6 rounded-2xl bg-gradient-to-br from-indigo-600 to-purple-800 text-white shadow-xl shadow-indigo-900/30">
          <h4 class="text-lg font-black">Deep Violet Gradient</h4>
          <p class="text-xs text-indigo-100 mt-2">from-indigo-600 to-purple-800</p>
        </div>
        <div class="p-6 rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-800 text-white shadow-xl shadow-emerald-900/30">
          <h4 class="text-lg font-black">Emerald Glow Gradient</h4>
          <p class="text-xs text-emerald-100 mt-2">from-emerald-600 to-teal-800</p>
        </div>
      </div>
    </TestSection>
  {else}
    <TestSection 
      phase="Phase 9" 
      title="Modern Typography & Code Formatting" 
      description="JetBrains Mono + Plus Jakarta Sans fonts and font hierarchy."
      status="PASS">
      <div class="space-y-4 p-6 rounded-xl bg-slate-950 border border-slate-800">
        <h1 class="text-4xl font-extrabold text-white tracking-tight">Display 4XL Heading</h1>
        <h2 class="text-2xl font-bold text-slate-200">Heading 2XL Subtitle</h2>
