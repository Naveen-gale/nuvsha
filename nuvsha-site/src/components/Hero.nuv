<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-label">
          <span class="hero-label-dot"></span>
          The Simple Frontend Framework
        </div>
        <h1>Build UI with <span class="gradient-text">less code.</span></h1>
        <p class="hero-desc">
          Write familiar HTML. Use simple JavaScript. Let Nuvsha handle the reactive UI.
        </p>
        <div class="hero-actions">
          <a href="#demo" class="btn btn-primary">Get Started</a>
          <a href="#features" class="btn btn-outline">View Examples</a>
        </div>
        <div class="hero-badge">
          <span>&#10003;</span>
          36/36 tests passing
        </div>
      </div>
      <div class="hero-visual">
        <div class="code-card">
          <div class="code-card-header">
            <div class="traffic-light">
              <span class="tl-dot tl-red"></span>
              <span class="tl-dot tl-yellow"></span>
              <span class="tl-dot tl-green"></span>
            </div>
            <span class="code-card-filename">App.nuv</span>
          </div>
          <div class="code-card-body">
            <div><span class="code-tag">&lt;script&gt;</span></div>
            <div>  count = <span class="code-val">0</span></div>
            <div><span class="code-tag">&lt;/script&gt;</span></div>
            <div>&nbsp;</div>
            <div><span class="code-tag">&lt;h1&gt;</span><span class="code-expr">{count}</span><span class="code-tag">&lt;/h1&gt;</span></div>
            <div>&nbsp;</div>
            <div><span class="code-tag">&lt;button</span> <span class="code-attr">onclick</span>=<span class="code-val">"count++"</span><span class="code-tag">&gt;</span></div>
            <div>  Add</div>
            <div><span class="code-tag">&lt;/button&gt;</span></div>
          </div>
          <div class="code-card-preview">
            <span class="preview-label">Preview</span>
            <span class="preview-count">0</span>
            <div class="preview-btns">
              <button class="preview-btn preview-btn-add" disabled>Add</button>
              <button class="preview-btn preview-btn-rem" disabled>&#8722;</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
