<script>
  currentPath = window.location.pathname
  
  getLinkClass = (path) => {
    return "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors " + 
           (currentPath === path ? "bg-sky-500/10 text-sky-400" : "text-slate-400 hover:text-white hover:bg-slate-900")
  }
</script>

<aside class="w-64 border-r border-slate-800 bg-slate-950 flex-shrink-0 hidden md:block">
  <div class="py-6 px-4">
    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-4 px-2">Main Menu</p>
    <nav class="space-y-1">
      <a href="/" class={getLinkClass('/')}>
        <span class="text-base">🏠</span> Dashboard
      </a>
      <a href="/analytics" class={getLinkClass('/analytics')}>
        <span class="text-base">📈</span> Analytics
      </a>
      <a href="/users" class={getLinkClass('/users')}>
        <span class="text-base">👥</span> Users
      </a>
      <a href="/projects" class={getLinkClass('/projects')}>
        <span class="text-base">📁</span> Projects
      </a>
      <a href="/tasks" class={getLinkClass('/tasks')}>
        <span class="text-base">✓</span> Tasks
      </a>
      <a href="/settings" class={getLinkClass('/settings')}>
        <span class="text-base">⚙️</span> Settings
      </a>
    </nav>
  </div>
</aside>
